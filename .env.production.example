# Production Environment Configuration Template
# DO NOT store real passwords or secrets in this file. Secrets are loaded via _FILE variables.

# FRITZ!Box Connection
# The user needs the "FRITZ!Box Settings" permission for mesh topology, per-client
# Wi-Fi and event-log data — otherwise those panels stay empty (the exporter
# reports this via fritz_capability_available). See docs/fritz-permissions.md.
FRITZ_HOST=192.168.178.1
FRITZ_PORT=49000
FRITZ_USERNAME=monitoring
FRITZ_USE_TLS=false
FRITZ_TIMEOUT=5.0

# Exporter Settings
EXPORTER_HOST=0.0.0.0
EXPORTER_PORT=8000
EXPORTER_COLLECTION_INTERVAL=30
EXPORTER_READY_MAX_AGE=120

# Network Bindings
GRAFANA_BIND_ADDRESS=127.0.0.1
SYSLOG_BIND_ADDRESS=192.168.178.10

# Retention Policies
PROMETHEUS_RETENTION_TIME=30d
LOKI_RETENTION_PERIOD=720h

# Secret File Paths
FRITZ_MONITOR_PASSWORD_FILE=./secrets/fritz_password.txt
GRAFANA_ADMIN_PASSWORD_FILE=./secrets/grafana_admin_password.txt
DEVICE_MANAGER_ADMIN_PASSWORD_FILE=./secrets/device_manager_admin_password.txt

# Operational Logging
LOG_LEVEL=INFO

# Active path probing (Blackbox Exporter) has no env config — edit the probe
# target lists directly (hot-reloaded, no restart):
#   config/blackbox/targets/icmp_infra.yml     add your repeater / powerline IPs
#   config/blackbox/targets/{icmp_internet,dns_local,dns_external}.yml

# Opt-in iperf3 LAN reference (compose --profile iperf). Off unless IPERF_TARGET
# is set. Interval floored at 600s, duration capped at 30s. See docs/iperf-reference.md.
# IPERF_TARGET=192.168.178.20
# IPERF_INTERVAL_SECONDS=21600
# IPERF_DURATION_SECONDS=5
# IPERF_BITRATE=
# IPERF_REVERSE=false

# ---------------------------------------------------------------------------
# Smart-home exporters (compose --profile smarthome, or hue|bosch|blink|
# fritzdect). Every exporter stays healthy with no config, reporting
# <vendor>_configured=0. Full setup: docs/smart-home-exporters.md
# ---------------------------------------------------------------------------

# Philips Hue — local CLIP v2 API. HUE_APP_KEY may be the key itself or a path
# to a file holding it (e.g. /secrets/hue_app_key.txt, mounted from ./secrets).
# HUE_BRIDGE_HOST=192.168.178.30
# HUE_APP_KEY=/secrets/hue_app_key.txt
# HUE_VERIFY_TLS=false
# HUE_INTERVAL_SECONDS=60

# Bosch Smart Home Controller — local REST API, client cert paired by button.
# Put the pair under ./secrets/ (git-ignored); they mount read-only at /secrets.
# BOSCH_SHC_HOST=192.168.178.31
# BOSCH_SHC_CERT_FILE=/secrets/bosch-shc-cert.pem
# BOSCH_SHC_KEY_FILE=/secrets/bosch-shc-key.pem
# BOSCH_INTERVAL_SECONDS=60

# Blink — Amazon cloud (no local API). First run needs the 2FA code; afterwards
# a token is cached in the home_iot_data volume and BLINK_2FA_KEY can be removed.
# Interval floored at 300s (cloud rate limits).
# BLINK_USERNAME=you@example.com
# BLINK_PASSWORD=/secrets/blink_password.txt   # literal password also accepted
# BLINK_2FA_KEY=123456
# BLINK_INTERVAL_SECONDS=600

# FRITZ!DECT sockets / thermostats — reuses the FRITZ!Box creds above.
# FRITZDECT_INTERVAL_SECONDS=60


# ---------------------------------------------------------------------------
# Weather (P3, compose --profile weather). DWD data via Bright Sky, no API key.
# Look up your coordinates once (e.g. https://www.openstreetmap.org right-click
# "show address"). Or set WEATHER_STATION to a DWD station id instead.
# ---------------------------------------------------------------------------
# WEATHER_LAT=52.520
# WEATHER_LON=13.405
# WEATHER_STATION=
# WEATHER_INTERVAL_SECONDS=300

# ---------------------------------------------------------------------------
# Speedtest (P4, compose --profile speedtest). Cloudflare speed test — no
# binary. Bandwidth-heavy: interval floored at 1800s, defaults to 3600s;
# each run moves ~SPEEDTEST_MAX_MB down + half that up.
# ---------------------------------------------------------------------------
# SPEEDTEST_INTERVAL_SECONDS=3600
# SPEEDTEST_MAX_MB=100

# node-exporter + cAdvisor (P1) are always on, no configuration.
# FRITZ!Box event-log -> Loki (P5) is on by default in the exporter
# (EMIT_DEVICE_LOG); it needs the Monitoring user to have "FRITZ!Box Settings".

# ---------------------------------------------------------------------------
# P0 Alertmanager -> ntfy. alertmanager + alertbridge are always on; alerts
# only leave the box once NTFY_TOPIC is set. Pick a long random topic and
# subscribe to it in the ntfy app (https://ntfy.sh/<topic>). For a private
# topic on your own server set NTFY_URL + NTFY_TOKEN (may be a /secrets path).
# ---------------------------------------------------------------------------
# NTFY_URL=https://ntfy.sh
# NTFY_TOPIC=fritz-mon-CHANGE-ME-to-something-random
# NTFY_TOKEN=
