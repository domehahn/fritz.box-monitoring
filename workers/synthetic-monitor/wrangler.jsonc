{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fritz-synthetic-monitor",
  "main": "src/index.js",
  "compatibility_date": "2026-04-01",
  "triggers": {
    "crons": ["*/1 * * * *"]
  },
  "vars": {
    "TARGET_URL": "https://monitoring.yourdomain.com/api/health",
    "CHECK_TIMEOUT_MS": "5000",
    "NOTIFICATION_SERVICE": "telegram",
    "TELEGRAM_BOT_TOKEN": "",
    "TELEGRAM_CHAT_ID": "",
    "PUSHOVER_USER_KEY": "",
    "PUSHOVER_API_TOKEN": "",
    "DISCORD_WEBHOOK_URL": ""
  }
}
