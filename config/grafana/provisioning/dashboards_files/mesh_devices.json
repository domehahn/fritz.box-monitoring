                  {
                    "options": {
                      "0": {
                        "color": "red",
                        "index": 0,
                        "text": "Offline"
                      },
                      "1": {
                        "color": "green",
                        "index": 1,
                        "text": "Online"
                      }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      }
    }
