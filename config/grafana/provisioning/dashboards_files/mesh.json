    {
      "id": 6,
      "type": "table",
      "title": "Mesh node health",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum without(__name__, job, instance, instance_type, model, ip) (fritz_node_info)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum without(__name__, job, instance, instance_type, model, ip) (fritz:node_health:code)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum without(__name__, job, instance, instance_type, model, ip) (fritz_node_up)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum without(__name__, job, instance, instance_type, model, ip) (fritz:node_connection_changes:24h)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum without(__name__, job, instance, instance_type, model, ip) (fritz_node_link_rx_kbps)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum without(__name__, job, instance, instance_type, model, ip) (fritz_node_link_tx_kbps)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "F"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum without(__name__, job, instance, instance_type, model, ip) (fritz_repeater_connected_devices or fritz_powerline_connected_devices)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "G"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum without(__name__, job, instance, instance_type, model, ip) (fritz:node_backhaul_health:ratio)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "H"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "mac": true
            },
            "indexByName": {
              "name": 0,
              "type": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #G": 5,
              "Value #E": 6,
              "Value #F": 7,
              "Value #H": 8
            },
            "renameByName": {
              "name": "Node",
              "type": "Type",
              "Value #A": "",
              "Value #B": "Health",
              "Value #C": "Up",
              "Value #D": "Flaps 24h",
              "Value #E": "Backhaul RX (kbps)",
              "Value #F": "Backhaul TX (kbps)",
              "Value #G": "Clients",
              "Value #H": "Backhaul health"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Health",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Health"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "HEALTHY",
                        "color": "green",
                        "index": 0
                      },
                      "2": {
                        "text": "DEGRADED",
                        "color": "orange",
                        "index": 1
                      },
                      "3": {
                        "text": "CRITICAL",
                        "color": "red",
                        "index": 2
                      },
                      "4": {
                        "text": "OFFLINE",
                        "color": "dark-red",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Up"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "OFFLINE",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "ONLINE",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Backhaul health"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      }
    },
