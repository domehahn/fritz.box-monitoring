            "lastNotNull",
            "max",
            "min"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "noValue": "No house meter \u2014 set SHELLY_HOST or a Tibber token. Bosch plug sum still shown."
        },
        "overrides": []
      }
    },
