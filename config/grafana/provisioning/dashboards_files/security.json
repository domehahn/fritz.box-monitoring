{
  "uid": "fritz_security",
  "title": "Network Security & Rogue Devices",
  "tags": [
    "fritzbox",
    "security",
    "dns",
    "pihole",
    "noc"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Sicherheits-Status & Erkennung",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Bekannte Geräte im Netzwerk",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 4 },
      "targets": [{ "expr": "fritz_total_devices", "instant": true, "refId": "A" }],
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Aktive UPnP-Portfreigaben",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 4 },
      "targets": [{ "expr": "fritz_upnp_port_mappings or vector(0)", "instant": true, "refId": "A" }],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Pi-hole / AdGuard Blockierquote",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "pihole_ads_percentage_today or adguard_blocked_filtering_percentage or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "orange", "value": null },
              { "color": "green", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Gastnetzwerk-Geräte (Isoliert)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "count(fritz_device_up{interface=~\"guest.*|wlan.*guest\"} == 1) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "purple" } } }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Neueste Geräte im Netzwerk (First-Seen Timeline)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "topk(15, netwatch_device_first_seen_timestamp_seconds > 0)",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true },
            "renameByName": {
              "mac": "MAC-Adresse",
              "name": "Host-/Gerätename",
              "ip": "IP-Adresse",
              "Value": "Erstmals gesehen"
            }
          }
        }
      ],
      "fieldConfig": {
        "overrides": [
          { "matcher": { "id": "byName", "options": "Erstmals gesehen" }, "properties": [{ "id": "unit", "value": "dateTimeAsIso" }] }
        ]
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "DNS-Abfragevolumen & Auffällige Aktivitätsspitzen",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 13, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "rate(pihole_dns_queries_total[2m]) or rate(adguard_dns_queries_total[2m])",
          "legendFormat": "DNS Queries/s",
          "refId": "A"
        },
        {
          "expr": "rate(pihole_ads_blocked_today[2m]) or rate(adguard_blocked_filtering[2m])",
          "legendFormat": "Geblockte Tracker/s",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } } }
    }
  ]
}
