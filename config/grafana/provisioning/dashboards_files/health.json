    {
      "id": 14,
      "type": "timeseries",
      "title": "$device \u2014 traffic by category",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (category) (rate(lantap_host_category_bytes_total{direction=\"rx\"}[2m]) * on(ip) group_left(name) lantap_host_info{name=~\"$device\"})*8",
          "legendFormat": "down {{category}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min"
