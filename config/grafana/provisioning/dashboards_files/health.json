      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 25,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "noValue": "Needs the lantap profile."
        },
        "overrides": []
      }
    },
