    {
      "id": 12,
      "type": "timeseries",
      "title": "Download by category \u2014 all devices",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (category) (rate(lantap_host_category_bytes_total{direction=\"rx\"}[2m]))*8",
          "legendFormat": "{{category}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
