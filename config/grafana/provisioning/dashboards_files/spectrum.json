{
  "uid": "fritz_spectrum",
  "title": "Wi-Fi Spectrum & Interference",
  "tags": [
    "fritzbox",
    "wifi",
    "spectrum",
    "dfs",
    "noc"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Kanalbelegung & Störstrahlung (2.4 GHz vs 5 GHz)",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Auslastung 2.4 GHz Kanal",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 5 },
      "targets": [
        {
          "expr": "max(fritz_wlan_channel_utilization_percent{band=\"2.4GHz\"}) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 60 },
              { "color": "red", "value": 80 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Auslastung 5 GHz Kanal",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 5 },
      "targets": [
        {
          "expr": "max(fritz_wlan_channel_utilization_percent{band=\"5GHz\"}) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 60 },
              { "color": "red", "value": 80 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Nicht-WLAN Störstrahlung (2.4 GHz)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 5 },
      "targets": [
        {
          "expr": "max(fritz_wlan_non_wifi_interference_percent{band=\"2.4GHz\"}) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 25 },
              { "color": "red", "value": 45 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "DFS / Radar-Wartezeit (5 GHz)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 5 },
      "targets": [
        {
          "expr": "max(fritz_wlan_dfs_active) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "🟢 INAKTIV / FREI", "color": "green" },
                "1": { "text": "🔴 RADAR PRÜFUNG AKTIV", "color": "red" }
              }
            }
          ]
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Kanalauslastung über Zeit (Verlauf 2.4 GHz vs 5 GHz)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "fritz_wlan_channel_utilization_percent",
          "legendFormat": "{{band}} (Kanal {{channel}})",
          "refId": "A"
        },
        {
          "expr": "fritz_wlan_non_wifi_interference_percent",
          "legendFormat": "Störquellen {{band}} (Kanal {{channel}})",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" }
        }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Aktive Funkkanal-Parameter der FRITZ!Box",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 6 },
      "targets": [
        {
          "expr": "fritz_wlan_channel",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "fritz_wlan_channel_width_mhz",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "fritz_wlan_channel_utilization_percent",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "fritz_wlan_non_wifi_interference_percent",
          "format": "table",
          "instant": true,
          "refId": "D"
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "Value #A": true
            },
            "renameByName": {
              "band": "Frequenzband",
              "channel": "Kanal",
              "Value #B": "Kanalbreite (MHz)",
              "Value #C": "Auslastung (%)",
              "Value #D": "Fremdstörung (%)"
            }
          }
        }
      ]
    }
  ]
}
