FROM python:3.11-slim

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application
COPY src/fritz_monitoring/ /app/fritz_monitoring/

# Set Python path
ENV PYTHONPATH=/app

# Expose port
EXPOSE 5000

# Run Flask app
CMD ["python", "/app/fritz_monitoring/device_manager/app.py"]
