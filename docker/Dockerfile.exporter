# Multi-stage Dockerfile for Fritz Exporter
FROM python:3.11-slim AS builder

WORKDIR /build

RUN pip install --no-cache-dir poetry poetry-plugin-export

COPY pyproject.toml ./
COPY fritz-avm-client /fritz-avm-client

RUN poetry export -f requirements.txt --output requirements.txt --without-hashes

FROM python:3.11-slim AS runtime

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -s /bin/sh appuser

COPY --from=builder /build/requirements.txt /tmp/requirements.txt
COPY --from=builder /fritz-avm-client /tmp/fritz-avm-client

RUN pip install --no-cache-dir /tmp/fritz-avm-client && \
    pip install --no-cache-dir -r /tmp/requirements.txt && \
    rm -rf /tmp/*

COPY src /app/src

USER appuser:appgroup

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/healthz')"

CMD ["python", "-m", "fritz_monitoring.exporter"]
